#include <iostream>
using namespace std;
 
int main() {
    int t,n,k,temp;
    cin>>t;
    for(int i=0;i<t;i++){
        cin>>n>>k;
        int a[n];
        temp=0;
        for(int i=0;i<n;i++){
            cin>>a[i];
            if(a[i]==k){
                temp=1;
            }
        }
        if(temp==1){
            cout<<"YES
";
        }
        else{
            cout<<"NO
";
        }
    }
    return 0;
}